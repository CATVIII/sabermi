<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ package visibility. Without this entry bindService() to
      com.xiaomi.touchservice fails silently and no gesture is ever delivered.
    -->
    <queries>
        <package android:name="com.xiaomi.touchservice" />
    </queries>
</manifest>
